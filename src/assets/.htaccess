# Disable directory listing
Options -Indexes

# Disable CGI execution
Options -ExecCGI

# Block script execution
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

# Allow only safe asset types
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|ttf|eot|ico|mp4)$">
    Require all granted
</FilesMatch>